@model EasyLearn.Models.Quiz
@{
    ViewData["Title"] = Model.Title;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Quiz Header -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0"><i class="fas fa-question-circle"></i> @Model.Title</h4>
                            <small>@Model.Course.Title</small>
                        </div>
                        <div class="text-end">
                            @if (Model.TimeLimit > 0)
                            {
                                <div id="timer" class="badge bg-warning text-dark fs-6">
                                    <i class="fas fa-clock"></i> <span id="time-remaining">@Model.TimeLimit:00</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-2">@Model.Description</p>
                    <div class="row text-center">
                        <div class="col-4">
                            <strong>@Model.Questions.Count</strong>
                            <br><small class="text-muted">Questions</small>
                        </div>
                        <div class="col-4">
                            <strong>@Model.PassingScore%</strong>
                            <br><small class="text-muted">Passing Score</small>
                        </div>
                        <div class="col-4">
                            <strong>@Model.Questions.Sum(q => q.Points)</strong>
                            <br><small class="text-muted">Total Points</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quiz Form -->
            <form id="quiz-form" asp-action="SubmitQuiz" asp-route-quizId="@Model.Id" method="post">
                <!-- Progress Bar -->
                <div class="card mb-3">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted">Progress</small>
                            <small class="text-muted"><span id="current-question">1</span> of @Model.Questions.Count</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div id="progress-bar" class="progress-bar" role="progressbar" 
                                 style="width: @(100.0 / Model.Questions.Count)%" 
                                 aria-valuenow="1" aria-valuemin="0" aria-valuemax="@Model.Questions.Count">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Questions -->
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var question = Model.Questions.ElementAt(i);
                    <div class="card mb-4 question-card @(i == 0 ? "" : "d-none")" data-question="@(i + 1)">
                        <div class="card-header">
                            <h5 class="mb-0">
                                Question @(i + 1) of @Model.Questions.Count
                                <span class="badge bg-secondary ms-2">@question.Points pts</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <h6 class="mb-4">@question.Text</h6>
                            
                            @if (question.Type == EasyLearn.Models.QuestionType.MultipleChoice)
                            {
                                <div class="row">
                                    @foreach (var answer in question.Answers.OrderBy(a => a.OrderIndex))
                                    {
                                        <div class="col-12 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" 
                                                       name="answers[@question.Id]" 
                                                       value="@answer.Text" 
                                                       id="answer@(question.Id)_@(answer.Id)">
                                                <label class="form-check-label w-100" for="answer@(question.Id)_@(answer.Id)">
                                                    <div class="p-3 border rounded hover-highlight">
                                                        @answer.Text
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (question.Type == EasyLearn.Models.QuestionType.TrueFalse)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" 
                                                   name="answers[@question.Id]" 
                                                   value="True" 
                                                   id="true_@question.Id">
                                            <label class="form-check-label w-100" for="true_@question.Id">
                                                <div class="p-3 border rounded text-center hover-highlight">
                                                    <i class="fas fa-check-circle text-success fa-2x mb-2"></i>
                                                    <br><strong>True</strong>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" 
                                                   name="answers[@question.Id]" 
                                                   value="False" 
                                                   id="false_@question.Id">
                                            <label class="form-check-label w-100" for="false_@question.Id">
                                                <div class="p-3 border rounded text-center hover-highlight">
                                                    <i class="fas fa-times-circle text-danger fa-2x mb-2"></i>
                                                    <br><strong>False</strong>
                                                </div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (question.Type == EasyLearn.Models.QuestionType.ShortAnswer)
                            {
                                <div class="mb-3">
                                    <textarea name="answers[@question.Id]" 
                                              class="form-control" 
                                              rows="4" 
                                              placeholder="Enter your answer here..."></textarea>
                                </div>
                            }
                        </div>
                        
                        <!-- Navigation -->
                        <div class="card-footer">
                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-secondary prev-btn @(i == 0 ? "d-none" : "")" 
                                        data-question="@(i + 1)">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </button>
                                
                                @if (i < Model.Questions.Count - 1)
                                {
                                    <button type="button" class="btn btn-primary next-btn" data-question="@(i + 1)">
                                        Next <i class="fas fa-chevron-right"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success" id="review-btn">
                                        <i class="fas fa-eye"></i> Review Answers
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- Review Section -->
                <div id="review-section" class="card d-none">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="fas fa-clipboard-check"></i> Review Your Answers</h5>
                    </div>
                    <div class="card-body">
                        <p>Please review your answers before submitting the quiz.</p>
                        <div id="answer-summary"></div>
                        
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Important:</strong> Once you submit, you cannot change your answers.
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-outline-secondary" id="back-to-questions">
                                <i class="fas fa-arrow-left"></i> Back to Questions
                            </button>
                            <button type="submit" class="btn btn-success btn-lg" id="submit-quiz">
                                <i class="fas fa-paper-plane"></i> Submit Quiz
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        
        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Question Navigator -->
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-list"></i> Question Navigator</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            <div class="col-3">
                                <button type="button" class="btn btn-outline-primary btn-sm w-100 question-nav-btn" 
                                        data-question="@(i + 1)" 
                                        id="nav-btn-@(i + 1)">
                                    @(i + 1)
                                </button>
                            </div>
                        }
                    </div>
                    
                    <hr>
                    
                    <div class="legend">
                        <small class="d-block mb-1">
                            <span class="badge bg-primary me-2"></span> Current
                        </small>
                        <small class="d-block mb-1">
                            <span class="badge bg-success me-2"></span> Answered
                        </small>
                        <small class="d-block">
                            <span class="badge bg-outline-secondary me-2"></span> Not Answered
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentQuestion = 1;
        let totalQuestions = @Model.Questions.Count;
        let timeLimit = @Model.TimeLimit; // in minutes
        let timeRemaining = timeLimit * 60; // in seconds
        let timerInterval;

        $(document).ready(function() {
            initializeQuiz();
            if (timeLimit > 0) {
                startTimer();
            }
        });

        function initializeQuiz() {
            updateNavigationButtons();
            updateProgressBar();
            
            // Navigation event handlers
            $('.next-btn').click(function() {
                let questionNum = parseInt($(this).data('question'));
                if (questionNum < totalQuestions) {
                    showQuestion(questionNum + 1);
                }
            });

            $('.prev-btn').click(function() {
                let questionNum = parseInt($(this).data('question'));
                if (questionNum > 1) {
                    showQuestion(questionNum - 1);
                }
            });

            $('.question-nav-btn').click(function() {
                let questionNum = parseInt($(this).data('question'));
                showQuestion(questionNum);
            });

            // Answer change handlers
            $('input[type="radio"], textarea').change(function() {
                updateAnswerStatus();
            });

            // Review handlers
            $('#review-btn').click(function() {
                showReviewSection();
            });

            $('#back-to-questions').click(function() {
                hideReviewSection();
            });

            // Form submission
            $('#quiz-form').submit(function(e) {
                if (!confirm('Are you sure you want to submit your quiz? You cannot change your answers after submission.')) {
                    e.preventDefault();
                }
            });

            // Hover effects
            $('.hover-highlight').hover(
                function() { $(this).addClass('bg-light'); },
                function() { $(this).removeClass('bg-light'); }
            );
        }

        function showQuestion(questionNum) {
            $('.question-card').addClass('d-none');
            $(`.question-card[data-question="${questionNum}"]`).removeClass('d-none');
            currentQuestion = questionNum;
            updateNavigationButtons();
            updateProgressBar();
        }

        function updateNavigationButtons() {
            $('.question-nav-btn').removeClass('btn-primary btn-success').addClass('btn-outline-secondary');
            $(`#nav-btn-${currentQuestion}`).removeClass('btn-outline-secondary').addClass('btn-primary');
            updateAnswerStatus();
        }

        function updateProgressBar() {
            let progress = (currentQuestion / totalQuestions) * 100;
            $('#progress-bar').css('width', progress + '%').attr('aria-valuenow', currentQuestion);
            $('#current-question').text(currentQuestion);
        }

        function updateAnswerStatus() {
            for (let i = 1; i <= totalQuestions; i++) {
                let hasAnswer = false;
                let questionCard = $(`.question-card[data-question="${i}"]`);
                
                // Check radio buttons
                if (questionCard.find('input[type="radio"]:checked').length > 0) {
                    hasAnswer = true;
                }
                
                // Check textareas
                if (questionCard.find('textarea').val().trim() !== '') {
                    hasAnswer = true;
                }
                
                let navBtn = $(`#nav-btn-${i}`);
                if (i === currentQuestion) {
                    navBtn.removeClass('btn-outline-secondary btn-success').addClass('btn-primary');
                } else if (hasAnswer) {
                    navBtn.removeClass('btn-outline-secondary btn-primary').addClass('btn-success');
                } else {
                    navBtn.removeClass('btn-primary btn-success').addClass('btn-outline-secondary');
                }
            }
        }

        function showReviewSection() {
            $('.question-card').addClass('d-none');
            generateAnswerSummary();
            $('#review-section').removeClass('d-none');
        }

        function hideReviewSection() {
            $('#review-section').addClass('d-none');
            showQuestion(currentQuestion);
        }

        function generateAnswerSummary() {
            let summary = '<div class="row">';
            
            for (let i = 1; i <= totalQuestions; i++) {
                let questionCard = $(`.question-card[data-question="${i}"]`);
                let questionText = questionCard.find('h6').text();
                let answer = 'Not answered';
                
                // Get selected answer
                let selectedRadio = questionCard.find('input[type="radio"]:checked');
                if (selectedRadio.length > 0) {
                    answer = selectedRadio.val();
                }
                
                let textareaAnswer = questionCard.find('textarea').val().trim();
                if (textareaAnswer !== '') {
                    answer = textareaAnswer.substring(0, 50) + (textareaAnswer.length > 50 ? '...' : '');
                }
                
                summary += `
                    <div class="col-md-6 mb-3">
                        <div class="border rounded p-3">
                            <strong>Question ${i}:</strong>
                            <p class="mb-1 text-muted small">${questionText}</p>
                            <p class="mb-0"><strong>Answer:</strong> ${answer}</p>
                        </div>
                    </div>
                `;
            }
            
            summary += '</div>';
            $('#answer-summary').html(summary);
        }

        function startTimer() {
            timerInterval = setInterval(function() {
                timeRemaining--;
                
                let minutes = Math.floor(timeRemaining / 60);
                let seconds = timeRemaining % 60;
                
                $('#time-remaining').text(
                    minutes.toString().padStart(2, '0') + ':' + 
                    seconds.toString().padStart(2, '0')
                );
                
                // Change color when time is running low
                if (timeRemaining <= 300) { // 5 minutes
                    $('#timer').removeClass('bg-warning').addClass('bg-danger text-white');
                }
                
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    alert('Time is up! The quiz will be submitted automatically.');
                    $('#quiz-form').submit();
                }
            }, 1000);
        }

        // Prevent accidental page refresh
        window.addEventListener('beforeunload', function(e) {
            e.preventDefault();
            e.returnValue = '';
        });
    </script>

    <style>
        .hover-highlight {
            transition: background-color 0.2s ease;
            cursor: pointer;
        }
        
        .question-nav-btn {
            aspect-ratio: 1;
        }
        
        .form-check-label {
            cursor: pointer;
        }
        
        .legend .badge {
            width: 20px;
            height: 20px;
        }
    </style>
}